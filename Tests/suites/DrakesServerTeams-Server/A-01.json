{
  "name": "A-01 admin rights are read from the server's admin list, live",
  "description": "A player on a team cannot move itself. After the server puts it on its admin list it can; after the server takes it off again it cannot.",
  "steps": [
    "freshServer()",
    { "do": "console", "command": "teams join red" },
    { "do": "wait", "seconds": 4 },
    { "do": "hook", "name": "teams.myTeam", "expect": "red", "label": "Player 1 joined red (PlayerChoice)" },
    { "do": "server", "cmd": "hook.call", "args": { "name": "teams.memberCount", "args": { "team": "red" } }, "expect": "1", "label": "the server has one member on red" },

    { "do": "console", "command": "teams assign me blue" },
    { "do": "wait", "seconds": 4 },
    { "do": "hook", "name": "teams.myTeam", "expect": "red", "label": "not an admin: the move is refused" },

    { "do": "server", "cmd": "admin.add", "args": { "who": "me" } },
    { "do": "server", "cmd": "admin.is", "args": { "who": "me" }, "expect": "True", "label": "the server lists Player 1 as an admin" },
    { "do": "wait", "seconds": 3 },
    { "do": "console", "command": "teams assign me blue" },
    { "do": "wait", "seconds": 4 },
    { "do": "hook", "name": "teams.myTeam", "expect": "blue", "label": "as an admin: moved to blue" },
    { "do": "server", "cmd": "hook.call", "args": { "name": "teams.memberCount", "args": { "team": "blue" } }, "expect": "1", "label": "the server agrees: one member on blue" },
    { "do": "server", "cmd": "hook.call", "args": { "name": "teams.memberCount", "args": { "team": "red" } }, "expect": "0", "label": "and none on red" },

    { "do": "server", "cmd": "admin.remove", "args": { "who": "me" } },
    { "do": "wait", "seconds": 3 },
    { "do": "console", "command": "teams assign me red" },
    { "do": "wait", "seconds": 4 },
    { "do": "hook", "name": "teams.myTeam", "expect": "blue", "label": "admin right taken away: refused again, still blue" }
  ]
}
