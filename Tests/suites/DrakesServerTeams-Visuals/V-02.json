{
  "name": "V-02 graves of four teams",
  "description": "Four graves in a row, one per team: team-colored light, floating icon, colored name text. Day, night and a close-up.",
  "steps": [
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "ember"
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "tide"
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "moss"
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "dusk"
      }
    },
    {
      "do": "hook",
      "name": "teams.removeGraves"
    },
    {
      "do": "hook",
      "name": "teams.deleteSampleIcon",
      "args": {
        "icon": "sample-banner"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.writeSampleIcon",
      "args": {
        "icon": "sample-banner"
      },
      "expect": "sample-banner.png",
      "label": "a custom icon file in the icons folder"
    },
    {
      "do": "hook",
      "name": "teams.defineTeam",
      "args": {
        "team": "ember",
        "title": "Ember",
        "color": "#E67E22",
        "icon": "shield",
        "glow": ""
      },
      "label": "team Ember: #E67E22, icon shield"
    },
    {
      "do": "hook",
      "name": "teams.defineTeam",
      "args": {
        "team": "tide",
        "title": "Tide",
        "color": "#2980B9",
        "icon": "star",
        "glow": ""
      },
      "label": "team Tide: #2980B9, icon star"
    },
    {
      "do": "hook",
      "name": "teams.defineTeam",
      "args": {
        "team": "moss",
        "title": "Moss",
        "color": "#27AE60",
        "icon": "sample-banner",
        "glow": ""
      },
      "label": "team Moss: #27AE60, icon sample-banner"
    },
    {
      "do": "hook",
      "name": "teams.defineTeam",
      "args": {
        "team": "dusk",
        "title": "Dusk",
        "color": "#8E44AD",
        "icon": "diamond",
        "glow": "#F1C40F"
      },
      "label": "team Dusk: #8E44AD, icon diamond"
    },
    {
      "do": "hook",
      "name": "teams.setTime",
      "args": {
        "time": 0.5
      }
    },
    {
      "do": "hook",
      "name": "teams.goClearing",
      "contains": ""
    },
    {
      "do": "wait",
      "seconds": 2.5
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": -3,
      "dz": -8
    },
    {
      "do": "peerJoin",
      "name": "Bob",
      "dx": 3,
      "dz": -8
    },
    {
      "do": "peerJoin",
      "name": "Amy",
      "dx": -6,
      "dz": -9
    },
    {
      "do": "peerJoin",
      "name": "Carol",
      "dx": 6,
      "dz": -9
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Alice",
        "team": "ember"
      },
      "expect": "ember"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bjornita",
        "team": "tide"
      },
      "expect": "tide",
      "label": "Bjornita is on tide"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bob",
        "team": "moss"
      },
      "expect": "moss",
      "label": "Bob is on moss"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Amy",
        "team": "dusk"
      },
      "expect": "dusk",
      "label": "Amy is on dusk"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Carol",
        "team": "ember"
      },
      "expect": "ember",
      "label": "Carol is on ember"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "teams.makeGrave",
      "args": {
        "player": "Bjornita",
        "dx": -6,
        "dz": 3
      },
      "expect": "tide",
      "label": "grave of Bjornita"
    },
    {
      "do": "hook",
      "name": "teams.makeGrave",
      "args": {
        "player": "Bob",
        "dx": -2,
        "dz": 3
      },
      "expect": "moss",
      "label": "grave of Bob"
    },
    {
      "do": "hook",
      "name": "teams.makeGrave",
      "args": {
        "player": "Amy",
        "dx": 2,
        "dz": 3
      },
      "expect": "dusk",
      "label": "grave of Amy"
    },
    {
      "do": "hook",
      "name": "teams.makeGrave",
      "args": {
        "player": "Carol",
        "dx": 6,
        "dz": 3
      },
      "expect": "ember",
      "label": "grave of Carol"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "screenshot",
      "name": "teams-graves-day",
      "clean": true
    },
    {
      "do": "hook",
      "name": "teams.setTime",
      "args": {
        "time": 0.12
      }
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "screenshot",
      "name": "teams-graves-night",
      "clean": true
    },
    {
      "do": "hook",
      "name": "teams.removeGraves"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "teams.makeGrave",
      "args": {
        "player": "Amy",
        "dx": 1.4,
        "dz": -1.2
      },
      "expect": "dusk",
      "label": "one grave up close"
    },
    {
      "do": "wait",
      "seconds": 1.2
    },
    {
      "do": "screenshot",
      "name": "teams-grave-closeup-dusk",
      "clean": true
    },
    {
      "do": "playAs",
      "who": "me"
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "ember"
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "tide"
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "moss"
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "dusk"
      }
    },
    {
      "do": "hook",
      "name": "teams.removeGraves"
    },
    {
      "do": "hook",
      "name": "teams.deleteSampleIcon",
      "args": {
        "icon": "sample-banner"
      }
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}