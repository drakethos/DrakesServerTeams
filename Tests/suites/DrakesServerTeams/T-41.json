{
  "name": "T-41 team members get through, others are stopped, per kind",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false",
        "7 Experimental/SpawnStonesExperimental": "false"
      }
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": 3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Bob",
      "dx": -3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Amy",
      "dx": 0,
      "dz": 4
    },
    {
      "do": "hook",
      "name": "teams.setAdmin",
      "args": {
        "on": true
      }
    },
    {
      "do": "hook",
      "name": "teams.setWardDefault",
      "args": {
        "what": "build",
        "on": true
      }
    },
    {
      "do": "hook",
      "name": "teams.setWardDefault",
      "args": {
        "what": "chests",
        "on": true
      }
    },
    {
      "do": "hook",
      "name": "teams.setWardDefault",
      "args": {
        "what": "doors",
        "on": false
      }
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Alice",
        "team": "red"
      },
      "expect": "red",
      "label": "Alice -> red"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bjornita",
        "team": "blue"
      },
      "expect": "blue",
      "label": "Bjornita -> blue"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bob",
        "team": "red"
      },
      "expect": "red",
      "label": "Bob -> red"
    },
    {
      "do": "place",
      "prefab": "TeamWard",
      "dz": 3,
      "as": "ward"
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Alice",
        "kind": "build"
      },
      "expect": true,
      "label": "Alice (builder) may build"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bob",
        "kind": "build"
      },
      "expect": true,
      "label": "Bob (same team) may build"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bjornita",
        "kind": "build"
      },
      "expect": false,
      "label": "Bjornita (blue) may not build"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Amy",
        "kind": "build"
      },
      "expect": false,
      "label": "Amy (no team) may not build"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bjornita",
        "kind": "chest"
      },
      "expect": false,
      "label": "Bjornita may not open chests"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bjornita",
        "kind": "door"
      },
      "expect": true,
      "label": "doors are open to her by default"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bob",
        "kind": "door"
      },
      "expect": true,
      "label": "Bob opens doors"
    },
    {
      "do": "hook",
      "name": "teams.wardFlags",
      "args": {
        "ward": "ward"
      },
      "expect": "on/on/off",
      "label": "build/chests/doors defaults"
    },
    {
      "do": "hook",
      "name": "teams.setWardDefault",
      "args": {
        "what": "doors",
        "on": true
      },
      "expect": "ProtectDoors=True",
      "label": "server turns door protection on"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bjornita",
        "kind": "door"
      },
      "expect": false,
      "label": "now Bjornita cannot open doors"
    },
    {
      "do": "hook",
      "name": "teams.setWardDefault",
      "args": {
        "what": "doors",
        "on": false
      }
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}