{
  "name": "T-14 two teams sharing a spawn point are flagged",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false",
        "7 Experimental/SpawnStonesExperimental": "false"
      }
    },
    {
      "do": "hook",
      "name": "teams.setSpawn",
      "args": {
        "team": "red",
        "x": 100,
        "y": 35,
        "z": 100
      },
      "expect": "100,35,100",
      "label": "red spawn point (100, 35, 100)"
    },
    {
      "do": "hook",
      "name": "teams.setSpawn",
      "args": {
        "team": "blue",
        "x": 100,
        "y": 35,
        "z": 100
      },
      "expect": "100,35,100",
      "label": "blue spawn point (100, 35, 100)"
    },
    {
      "do": "hook",
      "name": "teams.sharedSpawns",
      "expect": 1,
      "label": "red and blue share a point"
    },
    {
      "do": "hook",
      "name": "teams.setSpawn",
      "args": {
        "team": "blue",
        "x": -100,
        "y": 35,
        "z": -100
      },
      "expect": "-100,35,-100",
      "label": "blue spawn point (-100, 35, -100)"
    },
    {
      "do": "hook",
      "name": "teams.sharedSpawns",
      "expect": 0,
      "label": "giving blue its own point clears it"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}