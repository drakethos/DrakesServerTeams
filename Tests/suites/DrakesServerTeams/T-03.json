{
  "name": "T-03 a built chest carries its builder's team",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.usePieceTeams",
      "expect": true
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "hook",
      "name": "teams.assign",
      "args": {
        "team": "red"
      },
      "expect": "red",
      "label": "Alice is on red"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "hook",
      "name": "teams.pieceTeam",
      "args": {
        "target": "chest"
      },
      "expect": "red",
      "label": "the server stamped the chest red"
    },
    {
      "do": "hook",
      "name": "teams.isOnPieceTeam",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Alice is on the chest's team"
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "teams.assign",
      "args": {
        "team": "blue"
      },
      "expect": "blue",
      "label": "Bob is on blue"
    },
    {
      "do": "hook",
      "name": "teams.isOnPieceTeam",
      "args": {
        "target": "chest"
      },
      "expect": false,
      "label": "Bob (blue) is not"
    },
    {
      "do": "playAs",
      "who": "Carol"
    },
    {
      "do": "hook",
      "name": "teams.assign",
      "args": {
        "team": "red"
      },
      "expect": "red",
      "label": "Carol is on red"
    },
    {
      "do": "hook",
      "name": "teams.isOnPieceTeam",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Carol (red) is"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}