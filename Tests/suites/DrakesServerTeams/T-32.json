{
  "name": "T-32 death rules: admins switch them on and off",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false",
        "7 Experimental/SpawnStonesExperimental": "false"
      }
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "deathrules"
      },
      "contains": "Death rules: off",
      "label": "shows the rules (off)"
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "deathrules on"
      },
      "contains": "Death rules: on",
      "label": "teams deathrules on"
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "deathrules off"
      },
      "contains": "Death rules: off",
      "label": "teams deathrules off"
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "deathrules maybe"
      },
      "contains": "Usage",
      "label": "a bad word is refused"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}