{
  "name": "T-42 per ward overrides beat the server default",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false",
        "7 Experimental/SpawnStonesExperimental": "false"
      }
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": 3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Bob",
      "dx": -3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Amy",
      "dx": 0,
      "dz": 4
    },
    {
      "do": "hook",
      "name": "teams.setAdmin",
      "args": {
        "on": true
      }
    },
    {
      "do": "hook",
      "name": "teams.setWardDefault",
      "args": {
        "what": "build",
        "on": true
      }
    },
    {
      "do": "hook",
      "name": "teams.setWardDefault",
      "args": {
        "what": "chests",
        "on": true
      }
    },
    {
      "do": "hook",
      "name": "teams.setWardDefault",
      "args": {
        "what": "doors",
        "on": false
      }
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Alice",
        "team": "red"
      },
      "expect": "red",
      "label": "Alice -> red"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bjornita",
        "team": "blue"
      },
      "expect": "blue",
      "label": "Bjornita -> blue"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bob",
        "team": "red"
      },
      "expect": "red",
      "label": "Bob -> red"
    },
    {
      "do": "place",
      "prefab": "TeamWard",
      "dz": 3,
      "as": "ward"
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "ward"
      },
      "contains": "Team Ward of Red",
      "label": "teams ward describes it"
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "ward doors on"
      },
      "contains": "doors: protected",
      "label": "this ward protects doors"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bjornita",
        "kind": "door"
      },
      "expect": false,
      "label": "Bjornita cannot open its doors"
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "ward chests off"
      },
      "contains": "chests: open to everyone",
      "label": "this ward leaves chests open"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bjornita",
        "kind": "chest"
      },
      "expect": true,
      "label": "Bjornita can open its chests"
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "ward build off"
      },
      "contains": "build: open to everyone",
      "label": "this ward lets anyone build"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bjornita",
        "kind": "build"
      },
      "expect": true,
      "label": "Bjornita can build"
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "ward build inherit"
      },
      "contains": "server default",
      "label": "back to the default"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bjornita",
        "kind": "build"
      },
      "expect": false,
      "label": "blocked again"
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "ward doors maybe"
      },
      "contains": "Use on, off or inherit",
      "label": "a bad word is refused"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}