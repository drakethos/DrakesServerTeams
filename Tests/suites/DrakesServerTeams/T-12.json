{
  "name": "T-12 each team spawns at its own point",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false",
        "7 Experimental/SpawnStonesExperimental": "false"
      }
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": 3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Bob",
      "dx": -3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Amy",
      "dx": 0,
      "dz": 4
    },
    {
      "do": "hook",
      "name": "teams.setSpawn",
      "args": {
        "team": "red",
        "x": 100,
        "y": 35,
        "z": 100
      },
      "expect": "100,35,100",
      "label": "red spawn point (100, 35, 100)"
    },
    {
      "do": "hook",
      "name": "teams.setSpawn",
      "args": {
        "team": "blue",
        "x": -100,
        "y": 35,
        "z": -100
      },
      "expect": "-100,35,-100",
      "label": "blue spawn point (-100, 35, -100)"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Alice",
        "team": "red"
      },
      "expect": "red",
      "label": "Alice -> red"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bjornita",
        "team": "red"
      },
      "expect": "red",
      "label": "Bjornita -> red"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bob",
        "team": "blue"
      },
      "expect": "blue",
      "label": "Bob -> blue"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Amy",
        "team": "blue"
      },
      "expect": "blue",
      "label": "Amy -> blue"
    },
    {
      "do": "hook",
      "name": "teams.spawnOf",
      "args": {
        "player": "Alice"
      },
      "expect": "100,35,100",
      "label": "Alice spawns at (100, 35, 100)"
    },
    {
      "do": "hook",
      "name": "teams.spawnOf",
      "args": {
        "player": "Bjornita"
      },
      "expect": "100,35,100",
      "label": "Bjornita spawns at (100, 35, 100)"
    },
    {
      "do": "hook",
      "name": "teams.spawnOf",
      "args": {
        "player": "Bob"
      },
      "expect": "-100,35,-100",
      "label": "Bob spawns at (-100, 35, -100)"
    },
    {
      "do": "hook",
      "name": "teams.spawnOf",
      "args": {
        "player": "Amy"
      },
      "expect": "-100,35,-100",
      "label": "Amy spawns at (-100, 35, -100)"
    },
    {
      "do": "hook",
      "name": "teams.sharedSpawns",
      "expect": 0,
      "label": "no two teams share a spawn point"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bjornita",
        "team": "blue"
      },
      "expect": "blue",
      "label": "Bjornita -> blue"
    },
    {
      "do": "hook",
      "name": "teams.spawnOf",
      "args": {
        "player": "Bjornita"
      },
      "expect": "-100,35,-100",
      "label": "Bjornita moved to blue and now spawns at blue's point"
    },
    {
      "do": "hook",
      "name": "teams.spawnOf",
      "args": {
        "player": "Alice"
      },
      "expect": "100,35,100",
      "label": "Alice's spawn did not change"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}