{
  "name": "T-21 MoveToSpawnOnFirstTeam off: the team spawn only applies on respawn",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false"
      }
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": 3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Bob",
      "dx": -3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Amy",
      "dx": 0,
      "dz": 4
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/MoveToSpawnOnFirstTeam": "false"
      }
    },
    {
      "do": "hook",
      "name": "teams.setSpawn",
      "args": {
        "team": "red",
        "x": 100,
        "y": 35,
        "z": 100
      },
      "expect": "100,35,100",
      "label": "red spawn point (100, 35, 100)"
    },
    {
      "do": "hook",
      "name": "teams.clearTeleports"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bob",
        "team": "red"
      },
      "expect": "red",
      "label": "Bob -> red"
    },
    {
      "do": "hook",
      "name": "teams.teleportOrdered",
      "args": {
        "player": "Bob"
      },
      "expect": "none",
      "label": "no move ordered"
    },
    {
      "do": "hook",
      "name": "teams.spawnOf",
      "args": {
        "player": "Bob"
      },
      "expect": "100,35,100",
      "label": "but red is still where Bob respawns"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}