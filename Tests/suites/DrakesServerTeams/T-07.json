{
  "name": "T-07 the full sweep fixes forged stamps",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.usePieceTeams",
      "expect": true
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "hook",
      "name": "teams.assign",
      "args": {
        "team": "red"
      },
      "expect": "red",
      "label": "Alice is on red"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "hook",
      "name": "teams.forgeStamp",
      "args": {
        "target": "chest",
        "team": "blue"
      },
      "expect": "blue"
    },
    {
      "do": "hook",
      "name": "teams.sweepNow",
      "expect": true,
      "label": "start a sweep of the whole world"
    },
    {
      "do": "wait",
      "seconds": 5
    },
    {
      "do": "hook",
      "name": "teams.sweeping",
      "expect": false,
      "label": "the sweep finished"
    },
    {
      "do": "hook",
      "name": "teams.pieceTeam",
      "args": {
        "target": "chest"
      },
      "expect": "red",
      "label": "the sweep restored the chest"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}