{
  "name": "T-43 an admin changes the ward team; its look follows",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false"
      }
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": 3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Bob",
      "dx": -3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Amy",
      "dx": 0,
      "dz": 4
    },
    {
      "do": "hook",
      "name": "teams.setAdmin",
      "args": {
        "on": true
      }
    },
    {
      "do": "hook",
      "name": "teams.setWardDefault",
      "args": {
        "what": "build",
        "on": true
      }
    },
    {
      "do": "hook",
      "name": "teams.setWardDefault",
      "args": {
        "what": "chests",
        "on": true
      }
    },
    {
      "do": "hook",
      "name": "teams.setWardDefault",
      "args": {
        "what": "doors",
        "on": false
      }
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Alice",
        "team": "red"
      },
      "expect": "red",
      "label": "Alice -> red"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bjornita",
        "team": "blue"
      },
      "expect": "blue",
      "label": "Bjornita -> blue"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bob",
        "team": "red"
      },
      "expect": "red",
      "label": "Bob -> red"
    },
    {
      "do": "place",
      "prefab": "TeamWard",
      "dz": 3,
      "as": "ward"
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "hook",
      "name": "teams.wardLook",
      "args": {
        "ward": "ward"
      },
      "contains": "Red|#C0392B|icon|#C0392B",
      "label": "red label, glow, icon and light"
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "ward team blue"
      },
      "contains": "Team Ward team: Blue",
      "label": "teams ward team blue"
    },
    {
      "do": "hook",
      "name": "teams.pieceTeam",
      "args": {
        "target": "ward"
      },
      "expect": "blue",
      "label": "the stamp changed"
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "hook",
      "name": "teams.wardLook",
      "args": {
        "ward": "ward"
      },
      "contains": "Blue|#2980B9|icon",
      "label": "blue now"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bjornita",
        "kind": "build"
      },
      "expect": true,
      "label": "Bjornita is now on the ward team"
    },
    {
      "do": "hook",
      "name": "teams.wardPermits",
      "args": {
        "ward": "ward",
        "player": "Bob",
        "kind": "build"
      },
      "expect": false,
      "label": "Bob is not"
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "ward team purple"
      },
      "contains": "Unknown team"
    },
    {
      "do": "hook",
      "name": "teams.adminCommand",
      "args": {
        "line": "ward team none"
      },
      "contains": "team: none",
      "label": "teams ward team none"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}