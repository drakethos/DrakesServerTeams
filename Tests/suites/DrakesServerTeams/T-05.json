{
  "name": "T-05 the server removes a stamp it did not sign",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.usePieceTeams",
      "expect": true
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "hook",
      "name": "teams.assign",
      "args": {
        "team": "red"
      },
      "expect": "red",
      "label": "Alice is on red"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "teams.assign",
      "args": {
        "team": "blue"
      },
      "expect": "blue",
      "label": "Bob is on blue"
    },
    {
      "do": "hook",
      "name": "teams.forgeStamp",
      "args": {
        "target": "chest",
        "team": "blue"
      },
      "expect": "blue",
      "label": "a modified client stamps Alice's chest blue"
    },
    {
      "do": "hook",
      "name": "teams.checkPiece",
      "args": {
        "target": "chest"
      },
      "expect": "red",
      "label": "the server puts back the builder's team"
    },
    {
      "do": "hook",
      "name": "teams.isOnPieceTeam",
      "args": {
        "target": "chest"
      },
      "expect": false,
      "label": "Bob has no team access afterwards"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}