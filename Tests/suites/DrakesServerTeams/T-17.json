{
  "name": "T-17 auto-balance with three teams fills each before doubling up",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false",
        "7 Experimental/SpawnStonesExperimental": "false"
      }
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": 3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Bob",
      "dx": -3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Amy",
      "dx": 0,
      "dz": 4
    },
    {
      "do": "hook",
      "name": "teams.defineTeam",
      "args": {
        "team": "green",
        "title": "Green",
        "color": "#27AE60"
      },
      "expect": 3
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AutoBalance"
      }
    },
    {
      "do": "hook",
      "name": "teams.autoAssign",
      "args": {
        "player": "Alice"
      },
      "expect": "red"
    },
    {
      "do": "hook",
      "name": "teams.autoAssign",
      "args": {
        "player": "Bjornita"
      },
      "expect": "blue"
    },
    {
      "do": "hook",
      "name": "teams.autoAssign",
      "args": {
        "player": "Bob"
      },
      "expect": "green"
    },
    {
      "do": "hook",
      "name": "teams.autoAssign",
      "args": {
        "player": "Amy"
      },
      "expect": "red",
      "label": "the fourth doubles up on the first team"
    },
    {
      "do": "hook",
      "name": "teams.memberCount",
      "args": {
        "team": "red"
      },
      "expect": 2
    },
    {
      "do": "hook",
      "name": "teams.memberCount",
      "args": {
        "team": "blue"
      },
      "expect": 1
    },
    {
      "do": "hook",
      "name": "teams.memberCount",
      "args": {
        "team": "green"
      },
      "expect": 1
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      },
      "expect": true
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}