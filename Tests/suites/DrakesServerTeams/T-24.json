{
  "name": "T-24 graves carry the team of the player who died",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false"
      }
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": 3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Bob",
      "dx": -3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Amy",
      "dx": 0,
      "dz": 4
    },
    {
      "do": "setConfig",
      "values": {
        "4 Visuals/TeamGraveMarker": "true"
      }
    },
    {
      "do": "hook",
      "name": "teams.removeGraves"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bjornita",
        "team": "blue"
      },
      "expect": "blue",
      "label": "Bjornita -> blue"
    },
    {
      "do": "hook",
      "name": "teams.makeGrave",
      "args": {
        "player": "Bjornita"
      },
      "expect": "blue",
      "label": "her grave is written blue"
    },
    {
      "do": "wait",
      "seconds": 1.2
    },
    {
      "do": "hook",
      "name": "teams.graveInfo",
      "expect": "blue|#2980B9|#2980B9|icon|#2980B9",
      "label": "name text, light, icon and the base band in blue"
    },
    {
      "do": "hook",
      "name": "teams.removeGraves"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "setConfig",
      "values": {
        "4 Visuals/TeamGraveMarker": "false"
      }
    },
    {
      "do": "hook",
      "name": "teams.makeGrave",
      "args": {
        "player": "Bjornita"
      },
      "expect": "blue",
      "label": "marker off, new blue grave"
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "hook",
      "name": "teams.graveInfo",
      "contains": "|none|none",
      "label": "marker off: no light, no icon"
    },
    {
      "do": "setConfig",
      "values": {
        "4 Visuals/TeamGraveMarker": "true"
      }
    },
    {
      "do": "hook",
      "name": "teams.removeGraves"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "teams.makeGrave",
      "args": {
        "player": "Amy"
      },
      "expect": "",
      "label": "Amy has no team: a plain grave"
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "hook",
      "name": "teams.graveInfo",
      "contains": "|none|none",
      "label": "no light, no icon"
    },
    {
      "do": "hook",
      "name": "teams.removeGraves"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}