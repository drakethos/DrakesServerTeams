{
  "name": "T-06 pieces from before the mod get their builder's team",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.usePieceTeams",
      "expect": true
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "hook",
      "name": "teams.assign",
      "args": {
        "team": "red"
      },
      "expect": "red",
      "label": "Alice is on red"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "hook",
      "name": "teams.clearStamp",
      "args": {
        "target": "chest"
      },
      "expect": "",
      "label": "remove the stamp (as on a pre-mod chest)"
    },
    {
      "do": "hook",
      "name": "teams.checkPiece",
      "args": {
        "target": "chest"
      },
      "expect": "red",
      "label": "the server stamps it with Alice's team"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}