{
  "name": "T-09 wards and doors are stamped too",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.usePieceTeams",
      "expect": true
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "hook",
      "name": "teams.assign",
      "args": {
        "team": "red"
      },
      "expect": "red",
      "label": "Alice is on red"
    },
    {
      "do": "place",
      "prefab": "wood_door",
      "dz": 2.5,
      "as": "door"
    },
    {
      "do": "place",
      "prefab": "guard_stone",
      "dx": 3,
      "dz": 2.5,
      "as": "ward"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "hook",
      "name": "teams.pieceTeam",
      "args": {
        "target": "door"
      },
      "expect": "red",
      "label": "the door is red"
    },
    {
      "do": "hook",
      "name": "teams.pieceTeam",
      "args": {
        "target": "ward"
      },
      "expect": "red",
      "label": "the ward is red"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    }
  ]
}