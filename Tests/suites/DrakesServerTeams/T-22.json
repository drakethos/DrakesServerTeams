{
  "name": "T-22 players glow in their team color",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false",
        "7 Experimental/SpawnStonesExperimental": "false"
      }
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": 3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Bob",
      "dx": -3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Amy",
      "dx": 0,
      "dz": 4
    },
    {
      "do": "setConfig",
      "values": {
        "4 Visuals/TeamGlow": "true"
      }
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Alice",
        "team": "red"
      },
      "expect": "red",
      "label": "Alice -> red"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bjornita",
        "team": "blue"
      },
      "expect": "blue",
      "label": "Bjornita -> blue"
    },
    {
      "do": "wait",
      "seconds": 1.2
    },
    {
      "do": "hook",
      "name": "teams.glowOf",
      "args": {
        "player": "Alice"
      },
      "expect": "#C0392B",
      "label": "Alice glows red"
    },
    {
      "do": "hook",
      "name": "teams.glowOf",
      "args": {
        "player": "Bjornita"
      },
      "expect": "#2980B9",
      "label": "Bjornita glows blue"
    },
    {
      "do": "hook",
      "name": "teams.glowOf",
      "args": {
        "player": "Amy"
      },
      "expect": "none",
      "label": "Amy has no team: no glow"
    },
    {
      "do": "setConfig",
      "values": {
        "4 Visuals/TeamGlow": "false"
      }
    },
    {
      "do": "wait",
      "seconds": 1.2
    },
    {
      "do": "hook",
      "name": "teams.glowOf",
      "args": {
        "player": "Bjornita"
      },
      "expect": "none",
      "label": "the server switched glow off"
    },
    {
      "do": "setConfig",
      "values": {
        "4 Visuals/TeamGlow": "true"
      }
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}