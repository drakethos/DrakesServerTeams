{
  "name": "T-26 death rules: killed by the enemy team keeps gear and drops coins for the killer",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false"
      }
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": true,
        "appliesTo": "EnemyTeamKill",
        "keepEquipped": true,
        "lootable": "Coins",
        "percent": 100
      }
    },
    {
      "do": "clearInventory"
    },
    {
      "do": "hook",
      "name": "teams.clearGround"
    },
    {
      "do": "give",
      "prefab": "Coins",
      "count": 500
    },
    {
      "do": "give",
      "prefab": "Wood",
      "count": 50
    },
    {
      "do": "give",
      "prefab": "Flint",
      "count": 20
    },
    {
      "do": "give",
      "prefab": "AxeBronze",
      "equip": true
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "teams.simulateDeath",
      "args": {
        "killer": "blue"
      },
      "expect": "keep=1 drop=1 grave=2",
      "label": "killed by blue"
    },
    {
      "do": "teleport",
      "dx": 30
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "hook",
      "name": "teams.invCount",
      "args": {
        "item": "AxeBronze"
      },
      "expect": 1,
      "label": "the equipped axe stays with Alice"
    },
    {
      "do": "hook",
      "name": "teams.invEquipped",
      "args": {
        "item": "AxeBronze"
      },
      "expect": true,
      "label": "and is marked worn again"
    },
    {
      "do": "hook",
      "name": "teams.invCount",
      "args": {
        "item": "Coins"
      },
      "expect": 0,
      "label": "her coins left her"
    },
    {
      "do": "hook",
      "name": "teams.invCount",
      "args": {
        "item": "Wood"
      },
      "expect": 0,
      "label": "her wood left her"
    },
    {
      "do": "hook",
      "name": "teams.groundCount",
      "args": {
        "item": "Coins"
      },
      "expect": 500,
      "label": "all 500 coins lie on the ground for the killer"
    },
    {
      "do": "hook",
      "name": "teams.graveCount",
      "args": {
        "item": "Wood"
      },
      "expect": 50,
      "label": "wood is in the grave"
    },
    {
      "do": "hook",
      "name": "teams.graveCount",
      "args": {
        "item": "Flint"
      },
      "expect": 20,
      "label": "flint is in the grave"
    },
    {
      "do": "hook",
      "name": "teams.graveCount",
      "args": {
        "item": "AxeBronze"
      },
      "expect": 0,
      "label": "the axe is not in the grave"
    },
    {
      "do": "hook",
      "name": "teams.clearGround"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}