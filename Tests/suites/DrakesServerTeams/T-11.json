{
  "name": "T-11 moving a virtual player changes only that player",
  "description": "",
  "steps": [
    {
      "do": "hook",
      "name": "teams.setDeathRules",
      "args": {
        "enabled": false
      }
    },
    {
      "do": "hook",
      "name": "teams.removeTeam",
      "args": {
        "team": "green"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "red"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearSpawn",
      "args": {
        "team": "blue"
      }
    },
    {
      "do": "hook",
      "name": "teams.clearMembers"
    },
    {
      "do": "setConfig",
      "values": {
        "1 Assignment/AssignmentMode": "AdminOnly",
        "1 Assignment/PlayersCanSwitchTeams": "false",
        "1 Assignment/MoveToSpawnOnFirstTeam": "false",
        "7 Experimental/SpawnStonesExperimental": "false"
      }
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": 3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Bob",
      "dx": -3,
      "dz": 0
    },
    {
      "do": "peerJoin",
      "name": "Amy",
      "dx": 0,
      "dz": 4
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Alice",
        "team": "red"
      },
      "expect": "red",
      "label": "Alice -> red"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bjornita",
        "team": "red"
      },
      "expect": "red",
      "label": "Bjornita -> red"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bob",
        "team": "blue"
      },
      "expect": "blue",
      "label": "Bob -> blue"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Amy",
        "team": "blue"
      },
      "expect": "blue",
      "label": "Amy -> blue"
    },
    {
      "do": "hook",
      "name": "teams.assignTo",
      "args": {
        "player": "Bjornita",
        "team": "blue"
      },
      "expect": "blue",
      "label": "Bjornita -> blue"
    },
    {
      "do": "hook",
      "name": "teams.teamOf",
      "args": {
        "player": "Bjornita"
      },
      "expect": "blue",
      "label": "Bjornita moved to blue"
    },
    {
      "do": "hook",
      "name": "teams.teamOf",
      "args": {
        "player": "Alice"
      },
      "expect": "red",
      "label": "Alice is still red"
    },
    {
      "do": "hook",
      "name": "teams.teamOf",
      "args": {
        "player": "Bob"
      },
      "expect": "blue",
      "label": "Bob is still blue"
    },
    {
      "do": "hook",
      "name": "teams.myTeam",
      "expect": "red",
      "label": "the local client's own team did not follow Bjornita's state"
    },
    {
      "do": "hook",
      "name": "teams.memberCount",
      "args": {
        "team": "red"
      },
      "expect": 1,
      "label": "one left on red"
    },
    {
      "do": "hook",
      "name": "teams.memberCount",
      "args": {
        "team": "blue"
      },
      "expect": 3,
      "label": "three on blue"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesServerTeams"
    },
    {
      "check": "noErrors",
      "source": "Unity Log"
    }
  ]
}