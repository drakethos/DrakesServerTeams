<Project>
  <!-- No DrakeModsLibs dependency yet; a Libs adapter (LockSmith/RenameIt) would add it as a soft dependency. -->
  <PropertyGroup>
    <ThunderstoreName>DrakesServerTeams</ThunderstoreName>
    <ThunderstoreAuthor>DrakeMods</ThunderstoreAuthor>
    <RootNamespace>DrakesServerTeams</RootNamespace>
    <AssemblyName>DrakesServerTeams</AssemblyName>
    <Version>0.1.0-beta.2</Version>
    <BepInPluginName>DrakesServerTeams</BepInPluginName>
    <BepInGuid>com.drakemods.serverteams</BepInGuid>
    <ModInfoClass>DrakesServerTeamsPlugin</ModInfoClass>
    <Description>EARLY PREVIEW (beta). Server-wide teams for Valheim: team colors, icons, glow and graves, per-team spawn points, an admin panel, and a Team Ward. Back up your world and characters.</Description>
    <WebsiteUrl>https://github.com/drakethos/DrakesServerTeams</WebsiteUrl>
  </PropertyGroup>
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2351" />
    <ThunderstoreDependency Include="ValheimModding-Jotunn-2.30.2" />
  </ItemGroup>
</Project>
